# Use ONLY the Seoul subwayeasy-kr project. Fill actual values in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: public Turnstile site key. Its SECRET belongs only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SERVER ONLY: never use a NEXT_PUBLIC_ prefix. Configure as an encrypted Pages Secret.
SUBWAY_FACILITY_API_KEY=
